# Recension API
RECENSION_ENV=development
RECENSION_PORT=8080

# Local-only defaults. Production refuses these values and disables bootstrap.
RECENSION_API_KEY=dev-api-key
RECENSION_BOOTSTRAP_PASSWORD=dev-password
RECENSION_SESSION_SECRET=recension-dev-secret-change-me
RECENSION_BOOTSTRAP=true
RECENSION_ALLOW_SIGNUP=true

# Comma-separated origins, or * for local/dev. Leave empty in production behind same-origin proxy.
# RECENSION_CORS_ORIGINS=http://localhost:5173

# RECENSION_SESSION_TTL=168h
# RECENSION_MAX_BODY_BYTES=8388608
# RECENSION_MAX_BLOB_BYTES=67108864

RECENSION_DATABASE_URL=postgres://recension:recension@localhost:5432/recension?sslmode=disable

# S3-compatible object storage (MinIO locally via `make deps`).
# Leave RECENSION_S3_ENDPOINT empty to disable blob APIs.
# Production: prefer AWS S3 / R2 / other S3 API — MinIO server is AGPLv3 (see README).
RECENSION_S3_ENDPOINT=localhost:9000
RECENSION_S3_ACCESS_KEY=recension
RECENSION_S3_SECRET_KEY=recensionsecret
RECENSION_S3_BUCKET=recension
RECENSION_S3_USE_SSL=false

# SDK / examples
RECENSION_API_URL=http://localhost:8080
RECENSION_TEAM=acme
RECENSION_SUITE=students
RECENSION_VERSION=v1.0
