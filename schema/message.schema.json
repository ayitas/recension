{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://recension.dev/schema/message.schema.json",
  "title": "RecensionMessages",
  "type": "object",
  "required": ["version", "messages"],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1,
      "description": "Wire format version"
    },
    "messages": {
      "type": "array",
      "items": { "$ref": "#/$defs/Message" }
    }
  },
  "$defs": {
    "Message": {
      "type": "object",
      "required": ["metadata", "results", "metrics"],
      "properties": {
        "metadata": { "$ref": "#/$defs/Metadata" },
        "results": {
          "type": "array",
          "items": { "$ref": "#/$defs/Result" }
        },
        "metrics": {
          "type": "array",
          "items": { "$ref": "#/$defs/Metric" }
        }
      }
    },
    "Metadata": {
      "type": "object",
      "required": ["team", "suite", "version", "testcase", "builtAt"],
      "properties": {
        "team": { "type": "string", "minLength": 1 },
        "suite": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "testcase": { "type": "string", "minLength": 1 },
        "builtAt": { "type": "string", "format": "date-time" }
      }
    },
    "Result": {
      "type": "object",
      "required": ["key", "kind", "value"],
      "properties": {
        "key": { "type": "string" },
        "kind": { "enum": ["check", "assert"] },
        "value": { "$ref": "#/$defs/Value" },
        "rule": { "$ref": "#/$defs/ComparisonRule" }
      }
    },
    "Metric": {
      "type": "object",
      "required": ["key", "value"],
      "properties": {
        "key": { "type": "string" },
        "value": { "type": "integer", "description": "Duration in milliseconds" }
      }
    },
    "Value": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "enum": ["bool", "int", "uint", "float", "double", "string", "object", "array", "blob"]
        },
        "bool": { "type": "boolean" },
        "int": { "type": "integer" },
        "uint": { "type": "integer", "minimum": 0 },
        "float": { "type": "number" },
        "double": { "type": "number" },
        "string": { "type": "string" },
        "object": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/Value" }
        },
        "array": {
          "type": "array",
          "items": { "$ref": "#/$defs/Value" }
        },
        "blob": {
          "type": "object",
          "properties": {
            "digest": { "type": "string" },
            "mime": { "type": "string" },
            "ref": { "type": "string" }
          }
        }
      }
    },
    "ComparisonRule": {
      "type": "object",
      "properties": {
        "mode": { "enum": ["absolute", "relative"] },
        "min": { "type": "number" },
        "max": { "type": "number" },
        "percent": { "type": "boolean" }
      }
    }
  }
}
