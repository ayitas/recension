# Build from web/ context (compose sets dockerfile to this file).
FROM node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
RUN npm run build

FROM node:22-alpine
WORKDIR /app
ENV NODE_ENV=production
ENV PORT=3000
ENV HOST=0.0.0.0
RUN adduser -D -H -u 10001 recension
COPY --from=build --chown=recension:recension /app/build ./build
COPY --from=build --chown=recension:recension /app/package.json ./
COPY --from=build --chown=recension:recension /app/node_modules ./node_modules
USER recension
EXPOSE 3000
CMD ["node", "build"]
